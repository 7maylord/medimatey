# ── Ollama (local AI — runs on your machine) ──────────────────────────────
# Install Ollama: https://ollama.com
# Pull the model: ollama pull gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ── Google AI Studio (cloud fallback) ─────────────────────────────────────
# Get a free API key: https://aistudio.google.com/app/apikey
# Leave blank to use Ollama only.
GOOGLE_AI_API_KEY=

# ── Deployment note ───────────────────────────────────────────────────────
# On Vercel: set GOOGLE_AI_API_KEY in project settings.
# Ollama is not available in cloud deployments — Google AI is the fallback.
